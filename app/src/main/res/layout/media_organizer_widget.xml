<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/category_capture_widget_background"
    android:orientation="vertical"
    android:padding="10dp">
    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/widget_icon_content_description" android:src="@mipmap/ic_launcher" android:layout_gravity="start" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingBottom="5dp"
                android:text="整理媒体"
        android:textColor="#315D4A"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_photos_action"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/category_capture_widget_secondary_button"
        android:gravity="center"
                android:text="整理图片"
        android:textColor="#315D4A"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_videos_action"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/category_capture_widget_secondary_button"
        android:gravity="center"
                android:text="整理视频"
        android:textColor="#315D4A"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
