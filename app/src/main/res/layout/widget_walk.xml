<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_walk_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="漫步"
        android:textColor="#8B6A52"
        android:textSize="12sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_walk_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="1000"
        android:text="正在寻找一条笔记…"
        android:textColor="#332A24"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_walk_created_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="#8A786B"
        android:textSize="11sp"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/widget_walk_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="上一条"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_arrow_back"
            android:tint="#8B6A52" />
        <ImageButton
            android:id="@+id/widget_walk_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="下一条"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_arrow_forward"
            android:tint="#8B6A52" />
        <ImageButton
            android:id="@+id/widget_walk_random"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="重新随机"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_shuffle"
            android:tint="#8B6A52" />
    </LinearLayout>
</LinearLayout>
